# Local Docker: docker compose up -d
# Host port 5433 so this can run beside BAS Check on 5432.
DATABASE_URL=postgres://jobbook:jobbook@127.0.0.1:5433/jobbook

# Optional later. Server-only. Leave unset on a public no-login deploy.
# AI_GATEWAY_API_KEY=

# Optional. Server-only. One organisation ABN lookup (not a bulk list).
# Register: https://abr.business.gov.au/Tools/WebServicesRegister
# Leave unset to keep checksum-only (no ABR HTTP).
# ABR_GUID=

# Local Docker: docker compose up -d
# Host port 5433 so this can run beside BAS Check on 5432.
DATABASE_URL=postgres://jobbook:jobbook@127.0.0.1:5433/jobbook

# Optional. Clerk sign-in maps a user to one organisation (org_members).
# Leave unset on a public no-login deploy (recruiters click Load demo).
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional. Server-only. One organisation ABN lookup (not a bulk list).
# Register: https://abr.business.gov.au/Tools/WebServicesRegister
# Leave unset to keep checksum-only (no ABR HTTP).
# ABR_GUID=

# Optional. Server-only. Email a sent quote or live invoice via Resend.
# Leave unset on a public no-login deploy (anyone can click Email).
# RESEND_API_KEY=
# EMAIL_FROM=OG Job Book <noreply@example.com>

# Optional. Server-only. Pay with card via Stripe Checkout for amount due now.
# Leave unset on a public no-login deploy (anyone can click Pay with card).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional. Server-only. Post a live invoice to Xero (ACCREC) or MYOB (service sale).
# Credit notes go to Xero only. Leave unset on a public no-login deploy.
# Not OAuth. Sales account defaults to 200; MYOB income account defaults to 4-1000.
# XERO_ACCESS_TOKEN=
# XERO_TENANT_ID=
# XERO_SALES_ACCOUNT_CODE=200
# MYOB_ACCESS_TOKEN=
# MYOB_CLIENT_ID=
# MYOB_CF_URI=https://api.myob.com/accountright/
# MYOB_INCOME_ACCOUNT=4-1000

# Optional. Server-only. Queue due recurring invoices with Redis and BullMQ.
# Leave unset on a public no-login deploy. Local docker maps host 6380.
# REDIS_URL=redis://127.0.0.1:6380

